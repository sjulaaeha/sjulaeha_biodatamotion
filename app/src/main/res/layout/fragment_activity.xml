<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Back Button, Title, Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        </LinearLayout>

        <EditText
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/activity_item_background"
            android:hint="Search"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/accent_dark"
            android:textColorHint="@color/secondary_dark" />

        <!-- Quick Action Buttons -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="70dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/primary_dark"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:tint="@color/accent_dark" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity"
                        android:textColor="@color/accent_dark"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="70dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/secondary_dark"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_save"
                        android:tint="@color/primary_light" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My List"
                        android:textColor="@color/primary_light"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.gridlayout.widget.GridLayout>

        <!-- Section: Today -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/accent_dark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIEW"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/secondary_dark"
                android:padding="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/primary_light">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity"
                        android:textStyle="bold"
                        android:textColor="@color/secondary_dark"
                        android:textSize="20sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00 AM"
                        android:textColor="@color/secondary_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Belajar Mandiri"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Baca Artikel Teknologi"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Cek To-Do Hari Ini"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/primary_light">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My List"
                        android:textStyle="bold"
                        android:textColor="@color/secondary_dark"
                        android:textSize="20sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11:00 AM"
                        android:textColor="@color/secondary_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌 Ide Proyek"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌 Jadwal Kuliah Malam"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Section: All Activities -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Activities"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/accent_dark"
            android:layout_marginTop="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">
            <!-- Aktivitas harian -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/primary_light">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="06.00 - 07.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bangun pagi, mandi, dan sarapan" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="07.00 - 08.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Membaca buku atau artikel teknologi" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="08.00 - 12.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Belajar mandiri / mengerjakan tugas" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="12.00 - 13.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Istirahat dan makan siang" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="13.00 - 16.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kegiatan rumah / eksperimen proyek" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="16.00 - 17.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Olahraga ringan atau jalan sore" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="17.00 - 18.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bersih-bersih dan persiapan kuliah" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="18.00 - 21.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kuliah malam" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="2dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="21.00 - 22.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Review materi kuliah / bersantai" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="22.00" android:textColor="@color/accent_dark" android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tidur malam" android:textColor="@color/accent_dark" android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView> 