<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CBB4A3"
    tools:context=".ui.notifications.NotificationsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#C7A58F"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/title_pendidikan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendidikan"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#5C3A25" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Main Pendidikan Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/pendidikan_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#AF8971"
            app:layout_constraintTop_toBottomOf="@id/header_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:text="Jenjang"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="Nama Sekolah"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:text="Tahun"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- SD Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:text="Sekolah Dasar"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="SDN Munjul 1"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:text="2010 - 2016"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- SMP Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:text="SMP"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="SMPN 3 Solear"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:text="2016 - 2019"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- SMK Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:text="SMK"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="SMK Karya Bangsa Nusantara"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:text="2019 - 2022"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- Perguruan Tinggi Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:text="Perguruan Tinggi"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="Universitas Yatsi Madani"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:text="2022 - Sekarang"
                        android:textSize="14sp"
                        android:textColor="#5C3A25"
                        android:background="@drawable/biodata_item_background"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- Additional Info -->
                <!-- Removed: Program Studi, Semester, and IPK TextViews -->

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>